# Store this entire file as ONE SecureString parameter in AWS Systems Manager Parameter Store.
# Recommended parameter name: /cinema-one/prod/runtime-env

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8

# Recommended: Amazon RDS for PostgreSQL.
DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/cinema_one
DB_USERNAME=cinema_one
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD

SITE_BASE_URL=https://YOUR_DOMAIN
APP_DEMO_CONTENT_ENABLED=false

# First production deployment only:
# Set enabled=true with a strong unique password to create the first admin,
# deploy once, then change enabled=false in Parameter Store and redeploy.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_ADMIN_EMAIL=admin@YOUR_DOMAIN
APP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
APP_ADMIN_DISPLAY_NAME=Cinema One Admin
APP_ADMIN_RESET_PASSWORD=false
